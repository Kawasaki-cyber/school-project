{% extends 'base.html.twig' %}

{% block title %}Manage Medecins{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>👨‍⚕️ Medecins</h1>
        <div>
            <a href="{{ path('app_medecin_export_csv') }}" class="btn btn-outline-success me-2">
                <i class="fas fa-file-csv"></i> Export CSV
            </a>
            <a href="{{ path('app_admin_medecin_new') }}" class="btn btn-success">
                <i class="fas fa-plus"></i> Add Medecin
            </a>
        </div>
    </div>

    {# Search Form #}
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-10">
                    <input type="text" 
                           name="search" 
                           class="form-control" 
                           placeholder="🔍 Search by name, specialization, email or license number..." 
                           value="{{ search }}">
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">Search</button>
                </div>
                {% if search %}
                    <div class="col-12">
                        <a href="{{ path('app_admin_medecins') }}" class="btn btn-sm btn-outline-secondary">
                            <i class="fas fa-times"></i> Clear Search
                        </a>
                        <span class="text-muted ms-2">{{ medecins|length }} result(s) found</span>
                    </div>
                {% endif %}
            </form>
        </div>
    </div>

    {% if medecins is empty %}
        <div class="alert alert-info">
            {% if search %}
                No medecins found matching "{{ search }}".
            {% else %}
                No medecins found.
            {% endif %}
        </div>
    {% else %}
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Name</th>
                        <th>License</th>
                        <th>Specialization</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for medecin in medecins %}
                        <tr>
                            <td>{{ medecin.firstName }} {{ medecin.lastName }}</td>
                            <td><span class="badge bg-info">{{ medecin.licenseNumber }}</span></td>
                            <td>{{ medecin.specialization }}</td>
                            <td>{{ medecin.email }}</td>
                            <td>{{ medecin.phone }}</td>
                            <td>
                                <a href="{{ path('app_admin_medecin_show', {id: medecin.id}) }}" class="btn btn-sm btn-info">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a href="{{ path('app_admin_medecin_edit', {id: medecin.id}) }}" class="btn btn-sm btn-warning">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <form method="POST" action="{{ path('app_admin_medecin_delete', {id: medecin.id}) }}" style="display:inline;" onsubmit="return confirm('Are you sure?')">
                                    <button type="submit" class="btn btn-sm btn-danger">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}

    {# Rendezvous Table #}
    <div class="card mt-5">
        <div class="card-header">
            <strong>📅 Rendezvous</strong>
        </div>
        <div class="card-body">
            {% if rendezvous is empty %}
                <div class="alert alert-info mb-0">No rendezvous found.</div>
            {% else %}
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>Reference</th>
                                <th>Doctor</th>
                                <th>Patient</th>
                                <th>Date</th>
                                <th>Type</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for rdv in rendezvous %}
                                <tr>
                                    <td>{{ rdv.id }}</td>
                                    <td>{{ rdv.reference }}</td>
                                    <td>{{ rdv.medecin.firstName }} {{ rdv.medecin.lastName }}</td>
                                    <td>{{ rdv.patient.firstName }} {{ rdv.patient.lastName }}</td>
                                    <td>{{ rdv.dateHeure|date('Y-m-d H:i') }}</td>
                                    <td>{{ rdv.type }}</td>
                                    <td><span class="badge bg-primary">{{ rdv.statut }}</span></td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </div>

    <a href="{{ path('app_admin') }}" class="btn btn-secondary mt-3">
        <i class="fas fa-arrow-left"></i> Back to Dashboard
    </a>
</div>
{% endblock %}
