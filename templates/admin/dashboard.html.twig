{% extends 'base.html.twig' %}

{% block title %}Admin Dashboard{% endblock %}

{% block body %}
<nav class="navbar navbar-expand-lg navbar-dark bg-primary sticky-top">
    <div class="container-fluid">
        <a class="navbar-brand fw-bold" href="{{ path('app_admin') }}">
            <i class="fas fa-stethoscope"></i> Medical Admin
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item"><a class="nav-link" href="{{ path('app_admin_users') }}">Users</a></li>
                <li class="nav-item"><a class="nav-link" href="{{ path('app_admin_medecins') }}">Doctors</a></li>
                <li class="nav-item"><a class="nav-link" href="{{ path('app_admin_patients') }}">Patients</a></li>
                <li class="nav-item"><a class="nav-link" href="{{ path('app_admin_rendezvous') }}">Appointments</a></li>
                <li class="nav-item"><a class="nav-link" href="{{ path('app_logout') }}">Logout</a></li>
            </ul>
        </div>
    </div>
</nav>

<div class="container-fluid py-5">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="display-4 fw-bold">Admin Dashboard</h1>
            <p class="text-muted mb-0">Dernières données depuis la base</p>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-lg-3 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <h5 class="card-title">👥 Users</h5>
                    <p class="display-6 fw-bold text-primary">{{ users_count }}</p>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <h5 class="card-title">👨‍⚕️ Doctors</h5>
                    <p class="display-6 fw-bold text-success">{{ medecins_count }}</p>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <h5 class="card-title">🧑‍🦱 Patients</h5>
                    <p class="display-6 fw-bold text-danger">{{ patients_count }}</p>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <h5 class="card-title">📅 Appointments</h5>
                    <p class="display-6 fw-bold text-info">{{ rendezvous_count }}</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">🕒 Derniers rendez-vous (mis à jour)</h5>
                    <a class="btn btn-sm btn-outline-light" href="{{ path('app_admin_rendezvous') }}">Voir tout</a>
                </div>
                <div class="card-body">
                    {% if latest_rendezvous is empty %}
                        <div class="alert alert-info mb-0">Aucun rendez-vous.</div>
                    {% else %}
                        <div class="table-responsive">
                            <table class="table table-sm table-striped align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Patient</th>
                                        <th>Médecin</th>
                                        <th>Date RDV</th>
                                        <th>Statut</th>
                                        <th>Maj</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for rdv in latest_rendezvous %}
                                        <tr>
                                            <td>{{ rdv.id }}</td>
                                            <td>{{ rdv.patient.firstName ?? 'N/A' }} {{ rdv.patient.lastName ?? '' }}</td>
                                            <td>{{ rdv.medecin.firstName ?? 'N/A' }} {{ rdv.medecin.lastName ?? '' }}</td>
                                            <td>{{ rdv.dateHeure ? rdv.dateHeure|date('Y-m-d H:i') : 'N/A' }}</td>
                                            <td><span class="badge bg-primary">{{ rdv.statut }}</span></td>
                                            <td>
                                                {% if rdv.dateModification %}
                                                    {{ rdv.dateModification|date('Y-m-d H:i') }}
                                                {% else %}
                                                    {{ rdv.dateCreation ? rdv.dateCreation|date('Y-m-d H:i') : 'N/A' }}
                                                {% endif %}
                                            </td>
                                            <td><a class="btn btn-sm btn-outline-secondary" href="{{ path('app_admin_rendezvous_show', {id: rdv.id}) }}">Voir</a></td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">👥 Derniers utilisateurs</h5>
                    <a class="btn btn-sm btn-outline-light" href="{{ path('app_admin_users') }}">Voir tout</a>
                </div>
                <div class="card-body">
                    {% if latest_users is empty %}
                        <div class="alert alert-info mb-0">Aucun utilisateur.</div>
                    {% else %}
                        <div class="table-responsive">
                            <table class="table table-sm table-striped align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Email</th>
                                        <th>Nom</th>
                                        <th>Rôles</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for u in latest_users %}
                                        <tr>
                                            <td>{{ u.id }}</td>
                                            <td>{{ u.email }}</td>
                                            <td>{{ u.nom ?? '—' }}</td>
                                            <td><small>{{ u.roles|join(', ') }}</small></td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">👨‍⚕️ Derniers médecins</h5>
                    <a class="btn btn-sm btn-outline-light" href="{{ path('app_admin_medecins') }}">Voir tout</a>
                </div>
                <div class="card-body">
                    {% if latest_medecins is empty %}
                        <div class="alert alert-info mb-0">Aucun médecin.</div>
                    {% else %}
                        <div class="table-responsive">
                            <table class="table table-sm table-striped align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Nom</th>
                                        <th>Spécialité</th>
                                        <th>Email</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for m in latest_medecins %}
                                        <tr>
                                            <td>{{ m.id }}</td>
                                            <td>{{ m.firstName }} {{ m.lastName }}</td>
                                            <td>{{ m.specialization }}</td>
                                            <td>{{ m.email ?? '—' }}</td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-danger text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">🧑‍🦱 Derniers patients</h5>
                    <a class="btn btn-sm btn-outline-light" href="{{ path('app_admin_patients') }}">Voir tout</a>
                </div>
                <div class="card-body">
                    {% if latest_patients is empty %}
                        <div class="alert alert-info mb-0">Aucun patient.</div>
                    {% else %}
                        <div class="table-responsive">
                            <table class="table table-sm table-striped align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Nom</th>
                                        <th>Email</th>
                                        <th>Inscription</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for p in latest_patients %}
                                        <tr>
                                            <td>{{ p.id }}</td>
                                            <td>{{ p.firstName }} {{ p.lastName }}</td>
                                            <td>{{ p.email ?? '—' }}</td>
                                            <td>{{ p.registrationDate ? p.registrationDate|date('Y-m-d H:i') : 'N/A' }}</td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
