{% extends 'base.html.twig' %}

{% block title %}User Details{% endblock %}

{% block body %}
<div class="container mt-5">
    <h1>👤 User Details</h1>

    <div class="card mt-4">
        <div class="card-body">
            <h5 class="card-title">User Information</h5>
            <table class="table">
                <tbody>
                    <tr>
                        <th>ID</th>
                        <td>{{ user.id }}</td>
                    </tr>
                    <tr>
                        <th>Email</th>
                        <td>{{ user.email }}</td>
                    </tr>
                    <tr>
                        <th>Roles</th>
                        <td>
                            {% for role in user.roles %}
                                <span class="badge bg-primary">{{ role }}</span>
                            {% endfor %}
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="mt-3">
        <a href="{{ path('app_admin_users') }}" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Back to Users
        </a>
        <form method="POST" action="{{ path('app_admin_user_delete', {id: user.id}) }}" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this user?')">
            <button type="submit" class="btn btn-danger">
                <i class="fas fa-trash"></i> Delete User
            </button>
        </form>
    </div>
</div>
{% endblock %}
