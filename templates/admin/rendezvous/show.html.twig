{% extends 'base.html.twig' %}

{% block title %}Rendezvous Details{% endblock %}

{% block body %}
<div class="container mt-5">
    <h1>Rendezvous #{{ rendezvous.id }}</h1>

    <div class="card mt-4">
        <div class="card-body">
            <p><strong>Patient:</strong> {{ rendezvous.patient.firstName ?? 'N/A' }} {{ rendezvous.patient.lastName ?? '' }}</p>
            <p><strong>Medecin:</strong> {{ rendezvous.medecin.firstName ?? 'N/A' }} {{ rendezvous.medecin.lastName ?? '' }}</p>
            <p><strong>Date:</strong> {{ rendezvous.dateHeure|date('Y-m-d H:i') }}</p>
            <p><strong>Status:</strong> <span class="badge bg-primary">{{ rendezvous.statut }}</span></p>
            <p><strong>Reason:</strong> {{ rendezvous.motif ?? 'N/A' }}</p>
        </div>
    </div>

    <div class="mt-3">
        <a href="{{ path('app_admin_rendezvous') }}" class="btn btn-secondary">Back</a>
        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('app_admin_rendezvous_edit', {id: rendezvous.id}) }}" class="btn btn-warning">Edit</a>
            <form method="post" action="{{ path('app_admin_rendezvous_delete', {id: rendezvous.id}) }}" style="display:inline" onsubmit="return confirm('Delete this rendez-vous?');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete_rendezvous_' ~ rendezvous.id) }}">
                <button class="btn btn-danger" type="submit">Delete</button>
            </form>
        {% endif %}
    </div>
</div>
{% endblock %}
