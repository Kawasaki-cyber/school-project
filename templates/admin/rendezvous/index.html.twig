{% extends 'base.html.twig' %}

{% block title %}Rendezvous List{% endblock %}

{% block body %}
<div class="container mt-5">
    <h1>📅 Rendezvous Management</h1>

    {% if rendezvous is empty %}
        <div class="alert alert-info">No rendezvous found.</div>
    {% else %}
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Reference</th>
                    <th>Patient</th>
                    <th>Medecin</th>
                    <th>Date</th>
                    <th>Type</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for rdv in rendezvous %}
                    <tr>
                        <td>{{ rdv.id }}</td>
                        <td>{{ rdv.reference }}</td>
                        <td>{{ rdv.patient.firstName ?? 'N/A' }} {{ rdv.patient.lastName ?? '' }}</td>
                        <td>{{ rdv.medecin.firstName ?? 'N/A' }} {{ rdv.medecin.lastName ?? '' }}</td>
                        <td>{{ rdv.dateHeure|date('Y-m-d H:i') }}</td>
                        <td>{{ rdv.type }}</td>
                        <td><span class="badge bg-primary">{{ rdv.statut }}</span></td>
                        <td>
                            <a href="{{ path('app_admin_rendezvous_show', {id: rdv.id}) }}" class="btn btn-sm btn-info">View</a>
                            {% if is_granted('ROLE_ADMIN') %}
                                <a href="{{ path('app_admin_rendezvous_edit', {id: rdv.id}) }}" class="btn btn-sm btn-warning">Edit</a>
                                <form method="post" action="{{ path('app_admin_rendezvous_delete', {id: rdv.id}) }}" style="display:inline" onsubmit="return confirm('Delete this rendez-vous?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_rendezvous_' ~ rdv.id) }}">
                                    <button class="btn btn-sm btn-danger" type="submit">Delete</button>
                                </form>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}

    <a href="{{ path('app_admin') }}" class="btn btn-secondary mt-3">Back to Dashboard</a>
</div>
{% endblock %}
