{% extends 'base.html.twig' %}

{% block title %}User Dashboard{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row mb-4">
        <div class="col-md-8">
            <h1>Welcome, {{ user.nom }}! 👋</h1>
            <p class="text-muted">User Dashboard</p>
        </div>
        <div class="col-md-4 text-end">
            <a href="{{ path('app_logout') }}" class="btn btn-outline-danger">
                <i class="fas fa-sign-out-alt"></i> Logout
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="card shadow-sm mb-3">
                <div class="card-body">
                    <h5 class="card-title">📧 Account Information</h5>
                    <p><strong>Email:</strong> {{ user.email }}</p>
                    <p><strong>User Role:</strong> 
                        {% for role in user.roles %}
                            <span class="badge bg-primary">{{ role }}</span>
                        {% endfor %}
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm mb-3">
                <div class="card-body">
                    <h5 class="card-title">🔐 Security</h5>
                    <p>Manage your account settings and preferences.</p>
                    <a href="#" class="btn btn-sm btn-primary">Change Password</a>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Quick Links</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4">
                            <a href="{{ path('app_patient') }}" class="btn btn-outline-primary w-100 mb-2">
                                <i class="fas fa-user"></i> Patient Portal
                            </a>
                        </div>
                        <div class="col-md-4">
                            <a href="{{ path('app_medecin') }}" class="btn btn-outline-success w-100 mb-2">
                                <i class="fas fa-stethoscope"></i> Doctor Portal
                            </a>
                        </div>
                        <div class="col-md-4">
                            <a href="{{ path('app_admin') }}" class="btn btn-outline-info w-100 mb-2">
                                <i class="fas fa-cog"></i> Admin Panel
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
