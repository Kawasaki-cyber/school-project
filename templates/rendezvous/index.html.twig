{% extends 'base.html.twig' %}

{% block title %}Rendezvous{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>📅 Rendezvous</h1>
    </div>

    {% if rendezvous is empty %}
        <div class="alert alert-info">No rendezvous found.</div>
    {% else %}
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Reference</th>
                        <th>Patient</th>
                        <th>Doctor</th>
                        <th>Date</th>
                        <th>Type</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    {% for rdv in rendezvous %}
                        <tr>
                            <td>{{ rdv.id }}</td>
                            <td>{{ rdv.reference }}</td>
                            <td>{{ rdv.patient.firstName }} {{ rdv.patient.lastName }}</td>
                            <td>{{ rdv.medecin.firstName }} {{ rdv.medecin.lastName }}</td>
                            <td>{{ rdv.dateHeure|date('Y-m-d H:i') }}</td>
                            <td>{{ rdv.type }}</td>
                            <td><span class="badge bg-primary">{{ rdv.statut }}</span></td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}

    <a href="{{ path('app_user_dashboard') }}" class="btn btn-secondary mt-3">Back</a>
</div>
{% endblock %}
